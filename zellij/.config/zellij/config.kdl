// ------------------------------------------------------------------------------
// -> Appearance
// ------------------------------------------------------------------------------

// Built-in theme, no `themes` block required.
theme "kanagawa"

// No borders around panes.
pane_frames false

// ------------------------------------------------------------------------------
// -> Startup
// ------------------------------------------------------------------------------

// No tips or release notes on launch.
show_startup_tips false
show_release_notes false

// ------------------------------------------------------------------------------
// -> Notes
// ------------------------------------------------------------------------------

// Everything not set here uses the zellij defaults, including all keybinds,
// so upgrades pick up new default bindings automatically.
//
// To see every available option with its default value:
//
//   zellij setup --dump-config
