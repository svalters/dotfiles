# ------------------------------------------------------------------------------
# -> User
# ------------------------------------------------------------------------------

[user]
  name = Valters
  email = info@svalters.com

# ------------------------------------------------------------------------------
# -> Settings
# ------------------------------------------------------------------------------

[init]
  defaultBranch = main

[push]
  default = simple
  autoSetupRemote = true

[pull]
  rebase = true

[rebase]
  autoStash = true

[core]
  editor = nvim
  pager = env LESS='' delta --paging=always

[commit]
  verbose = true

[branch]
  sort = -committerdate

[rerere]
  enabled = true

# ------------------------------------------------------------------------------
# -> Remotes
# ------------------------------------------------------------------------------

[url "git@github.com:"]
  insteadOf = https://github.com/

# ------------------------------------------------------------------------------
# -> Diffs and merges
# ------------------------------------------------------------------------------

[diff]
  algorithm = histogram
  colorMoved = zebra

[merge]
  conflictStyle = zdiff3

[interactive]
  diffFilter = delta --color-only

[delta]
  line-numbers = true
  navigate = true
